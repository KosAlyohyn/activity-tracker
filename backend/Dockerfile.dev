FROM ruby:4.0.7-slim

WORKDIR /app

# Dependencies for PostgreSQL and native Ruby gems
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      libpq-dev \
      libyaml-dev \
      pkg-config \
      git && \
    rm -rf /var/lib/apt/lists/*

# Install gems separately to cache dependencies
COPY Gemfile Gemfile.lock ./

RUN bundle install

# Application source will be mounted via Docker Compose
EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0"]
